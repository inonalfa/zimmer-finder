{
  "name": "zimmer-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Agent-powered vacation rental finder: your AI agent searches, a static web app shows the results with photos, prices, map and couple voting.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:py": "python3 -m unittest discover -s tests",
    "validate": "python3 scripts/zf.py validate",
    "check": "npm run lint && npm test && npm run test:py && npm run validate && npm run build",
    "example": "python3 scripts/make_example_data.py"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
